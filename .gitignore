# This .gitignore file should be placed at the root of your Git repository
# Unity project files are located in the unityeditor/ directory.
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore

/unityeditor/.utmp/
/unityeditor/[Ll]ibrary/
/unityeditor/[Tt]emp/
/unityeditor/[Oo]bj/
/unityeditor/[Bb]uild/
/unityeditor/[Bb]uilds/
/unityeditor/[Ll]ogs/
/unityeditor/[Uu]ser[Ss]ettings/
/unityeditor/**/*.log

# Blender
/unityeditor/**/*.blend1
/unityeditor/**/*.blend1.meta

# MemoryCaptures
/unityeditor/[Mm]emoryCaptures/

# Recordings
/unityeditor/[Rr]ecordings/

# Asset Store Tools
# Uncomment this line if you wish to ignore the asset store tools plugin
# /unityeditor/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/unityeditor/[Aa]ssets/Plugins/Editor/JetBrains*

# Jetbrains Rider personal-layer settings
/unityeditor/**/*.DotSettings.user

# Visual Studio cache directory
/unityeditor/**/.vs/

# Gradle cache directory
/unityeditor/**/.gradle/

# Autogenerated IDE solution and project files
/unityeditor/**/ExportedObj/
/unityeditor/**/.consulo/
/unityeditor/**/*.csproj
/unityeditor/**/*.unityproj
/unityeditor/**/*.sln
/unityeditor/**/*.slnx
/unityeditor/**/*.suo
/unityeditor/**/*.tmp
/unityeditor/**/*.user
/unityeditor/**/*.userprefs
/unityeditor/**/*.pidb
/unityeditor/**/*.booproj
/unityeditor/**/*.svd
/unityeditor/**/*.pdb
/unityeditor/**/*.mdb
/unityeditor/**/*.opendb
/unityeditor/**/*.VC.db

# Unity3D generated meta files
/unityeditor/**/*.pidb.meta
/unityeditor/**/*.pdb.meta
/unityeditor/**/*.mdb.meta

# Unity3D generated file on crash reports
/unityeditor/**/sysinfo.txt

# Mono auto generated files
/unityeditor/**/mono_crash.*

# Builds
/unityeditor/**/*.apk
/unityeditor/**/*.aab
/unityeditor/**/*.unitypackage
/unityeditor/**/*.unitypackage.meta
/unityeditor/**/*.app

# Crashlytics generated file
/unityeditor/**/crashlytics-build.properties

# TestRunner generated files
/unityeditor/**/InitTestScene*.unity*

# Addressables default ignores
/unityeditor/**/ServerData
/unityeditor/[Aa]ssets/StreamingAssets/aa*
/unityeditor/[Aa]ssets/AddressableAssetsData/link.xml*
/unityeditor/[Aa]ssets/Addressables_Temp*
/unityeditor/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/unityeditor/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/unityeditor/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/unityeditor/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/unityeditor/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/unityeditor/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Auto-generated cache in Assets folder
/unityeditor/[Aa]ssets/[Ss]ceneDependencyCache*